{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "macOS and Linux",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "mac",
            "displayName": "macOS, the app to hand out: vcpkg, Apple silicon, macOS 13 or later",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-mac",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_TARGET_TRIPLET": "arm64-osx-13",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows, with vcpkg and GStreamer's OpenSSL",
            "binaryDir": "${sourceDir}/build",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static-md" }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "mac", "configurePreset": "mac" },
        { "name": "windows", "configurePreset": "windows", "configuration": "Release" }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "mac",
            "configurePreset": "mac",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "windows",
            "configurePreset": "windows",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        }
    ]
}
