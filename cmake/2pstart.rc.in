// The Windows program's own resources (CMakeLists.txt): its icon, which Explorer, the taskbar and the
// window show; the tray's two with the status dot (tray_win.cpp); and what Properties says of it.
#include <winver.h>

1 ICON "@CMAKE_SOURCE_DIR@/icon/2pstart.ico"
2 ICON "@CMAKE_SOURCE_DIR@/icon/tray-online.ico"
3 ICON "@CMAKE_SOURCE_DIR@/icon/tray-invite.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "2P Start"
            VALUE "ProductName", "CabinetOS 2P Start"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "2P Start.exe"
            VALUE "InternalName", "2pstart"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
