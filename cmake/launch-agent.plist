<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Startup, inside the Mac app (startup.h): the system's Login Items start it at login, with no
     window. Once, in the person's own session with its screen: never again by itself. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.mmagtech.2pstart</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/2P Start</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/2P Start</string>
		<string>--startup</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>AssociatedBundleIdentifiers</key>
	<string>io.github.mmagtech.2pstart</string>
</dict>
</plist>
